rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == '20261ac0080020@estudantes.ifpr.edu.br';
    }

    function isAdmin() {
      return isBootstrappedAdmin()
        || (isVerified() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isVerified() && isValidId(userId) && request.auth.uid == userId;
    }

    // Entity Validators
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && (data.uid == request.auth.uid || isAdmin())
        && data.displayName is string
        && data.displayName.size() >= 2
        && data.displayName.size() <= 60
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPlayerProgress(data, userId) {
      return data.keys().hasAll([
          'uid',
          'solvedIds',
          'hintsUsedByLevel',
          'omegaUnlockedWithMasterKey',
          'endlessSolvedCount',
          'endlessBestStreak',
          'soundEnabled',
          'musicEnabled',
          'musicVolume',
          'currentTrackIndex',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'solvedIds',
          'hintsUsedByLevel',
          'omegaUnlockedWithMasterKey',
          'endlessSolvedCount',
          'endlessBestStreak',
          'soundEnabled',
          'musicEnabled',
          'musicVolume',
          'currentTrackIndex',
          'updatedAt'
        ])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && (data.uid == request.auth.uid || isAdmin())
        && data.solvedIds is list
        && data.solvedIds.size() <= 20
        && (data.solvedIds.size() == 0 || (data.solvedIds[0] is string && data.solvedIds[0].size() <= 24))
        && data.hintsUsedByLevel is map
        && data.hintsUsedByLevel.size() <= 20
        && data.omegaUnlockedWithMasterKey is bool
        && data.endlessSolvedCount is int
        && data.endlessSolvedCount >= 0
        && data.endlessSolvedCount <= 100000
        && data.endlessBestStreak is int
        && data.endlessBestStreak >= 0
        && data.endlessBestStreak <= 100000
        && data.soundEnabled is bool
        && data.musicEnabled is bool
        && data.musicVolume is number
        && data.musicVolume >= 0
        && data.musicVolume <= 1
        && data.currentTrackIndex is int
        && data.currentTrackIndex >= 0
        && data.currentTrackIndex <= 20
        && data.updatedAt is timestamp;
    }

    function isValidAdminGrant(data, userId) {
      return data.keys().hasAll(['uid', 'label', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'label', 'grantedBy', 'createdAt'])
        && data.uid is string
        && isValidId(data.uid)
        && data.uid == userId
        && data.label is string
        && data.label.size() >= 2
        && data.label.size() <= 60
        && data.grantedBy is string
        && isValidId(data.grantedBy)
        && data.grantedBy == request.auth.uid
        && data.createdAt is timestamp;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'message', 'active', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly(['title', 'message', 'active', 'updatedBy', 'updatedAt'])
        && data.title is string
        && data.title.size() >= 2
        && data.title.size() <= 80
        && data.message is string
        && data.message.size() >= 2
        && data.message.size() <= 300
        && data.active is bool
        && data.updatedBy is string
        && isValidId(data.updatedBy)
        && data.updatedBy == request.auth.uid
        && data.updatedAt is timestamp;
    }

    function isParentProfileValid(userId) {
      return exists(/databases/$(database)/documents/users/$(userId))
        && get(/databases/$(database)/documents/users/$(userId)).data.uid == userId;
    }

    // Users Collection (PII strictly isolated to owner or verified Admin)
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if (isOwner(userId) || isAdmin())
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);
      allow delete: if false;

      // Player Progress Subcollection (Master Gate enforced)
      match /progress/{progressId} {
        allow get: if (isOwner(userId) || isAdmin())
          && isValidId(progressId)
          && progressId == 'main'
          && isParentProfileValid(userId);
        allow list: if false;
        allow create: if (isOwner(userId) || isAdmin())
          && isValidId(progressId)
          && progressId == 'main'
          && isValidPlayerProgress(incoming(), userId)
          && incoming().updatedAt == request.time
          && isParentProfileValid(userId);
        allow update: if (isOwner(userId) || isAdmin())
          && isValidId(progressId)
          && progressId == 'main'
          && isValidPlayerProgress(incoming(), userId)
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'solvedIds',
            'hintsUsedByLevel',
            'omegaUnlockedWithMasterKey',
            'endlessSolvedCount',
            'endlessBestStreak',
            'soundEnabled',
            'musicEnabled',
            'musicVolume',
            'currentTrackIndex',
            'updatedAt'
          ])
          && isParentProfileValid(userId);
        allow delete: if false;
      }
    }

    // Trusted Admin Grants Collection
    match /admins/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isBootstrappedAdmin();
      allow create: if isAdmin()
        && isValidId(userId)
        && isValidAdminGrant(incoming(), userId)
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Official Admin Announcement Banner (Read by players, written only by Admin)
    match /announcements/{announcementId} {
      allow get: if isValidId(announcementId) && announcementId == 'banner';
      allow list: if false;
      allow create: if isAdmin()
        && isValidId(announcementId)
        && announcementId == 'banner'
        && isValidAnnouncement(incoming())
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(announcementId)
        && announcementId == 'banner'
        && isValidAnnouncement(incoming())
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'message', 'active', 'updatedBy', 'updatedAt']);
      allow delete: if false;
    }
  }
}
